          <section>
            <title value="1. Name of the Medicinal pro"/>
            <text>
              <status value="additional"/>
              <div xmlns="http://www.w3.org/1999/xhtml">
                <!-- The paragraph maps to the whole product name in productName -->
                <!-- Spans inside the paragraph could map to specific namePart elements -->
                <p id="fungisynth-product-name-01">Fungisynth 500 mg tablets.</p>
              </div>
            </text>
          </section>
          <section>
            <title value="Section 4"/>
            <section>
              <title value="Contraindications"/>
              <text>
                <status value="additional"/>
                <div xmlns="http://www.w3.org/1999/xhtml">
                  <p id="synthazole-allergy">
                    Do not take
                    <span id="fungisynth-product-01">Fungisynth</span>
                    if you are allergic to
                    <span id="subst-synthazole-01">synthazole</span>.
                  </p>
                  <p id="contraind-under-2-yr">
                    Do not give
                    <span id="fungisynth-product-02">Fungisynth</span>
                    to
                    <span id="grp-under-2-yr">children under 2 years of age</span>.
                  </p>
                </div>
              </text>
